# ============================================================
# 依赖与构建产物
# ============================================================
node_modules/
dist/
build/
*.tsbuildinfo

# Vite 加载 TS 配置时生成的临时文件（内含写死的本机绝对路径）
client/vite.config.ts.timestamp-*.mjs

# ============================================================
# 凭据与本地配置（绝不提交）
# ============================================================
.env
.env.local
.env.*.local
douyin-fav-transcribe/config.json       # 里面是真实 API Key
douyin-fav-transcribe/config.env        # 里面是你本机的路径

# 注意：.env.example / config.example.env 是给别人看的模板，必须提交，
# 上面这几条按文件名精确匹配，不会误伤它们。

# ============================================================
# 运行时状态（含登录态，绝不提交）
#
# douyin-fav-transcribe/state/profile/ 是一整个 Chrome 用户数据目录，
# 里面有 Default/Network/Cookies（抖音登录态）与 Default/Login Data（保存的密码）。
# 整个 state/ 一律忽略，别只忽略其中几个子目录。
# ============================================================
douyin-fav-transcribe/state/
douyin-fav-transcribe/work/
douyin-fav-transcribe/downloads/
douyin-fav-transcribe/config.json.bak*

# 阅读 Agent 的行为日志（只影响 memory 编译依据，不进笔记库）
server/.state/

# 转写工人的 Python 缓存
__pycache__/
*.py[cod]
*.egg-info/

# ============================================================
# 工作区笔记（含个人路径与项目内部记录，不对外）
# ============================================================
.workbuddy/
.claude/

# ============================================================
# 日志与系统文件
# ============================================================
*.log
.DS_Store
Thumbs.db

# ============================================================
# 编辑器
# ============================================================
.vscode/
.idea/
