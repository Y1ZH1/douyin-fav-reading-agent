REM =====================================================================
REM  本地配置模板
REM  复制本文件为 config.env（已被 .gitignore 忽略，不会上传），
REM  取消对应行的 REM 注释并填入你自己的值即可。
REM  Windows 下用 set；macOS / Linux 用 export。
REM =====================================================================

REM 笔记落库【根】目录：其下按来源分成 收藏/ 与 喜欢/ 两个桶，
REM 收藏的再按自建收藏夹名分子目录。不设则默认写到项目的 ./抖音/ 。
REM set DOUYIN_OBSIDIAN_DIR=E:\你的路径\Obsidian仓库\大道\抖音

REM Whisper 模型目录（默认 <cap-backend>/models，一般无需改）
REM set DOUYIN_MODELS_DIR=E:\你的路径\cap-backend\models

REM cap-backend 项目根目录（默认自动探测同级 ../cap-backend，一般无需改）
REM set CAP_BACKEND_DIR=E:\你的路径\cap-backend

REM 外文视频的翻译模式：aligned=逐句对照（默认）；whole=整段翻译
REM 仅影响「检测为外文」的视频；中文视频不会翻译。GUI 工具栏也可临时切换。
REM set DOUYIN_TRANSLATE_MODE=aligned

REM GUI 监听端口（默认 8899）
REM set DOUYIN_PORT=8899
